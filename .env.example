# Application Settings
APP_NAME="Sanskriti AI - Karnataka Cultural Tourism Subsystem"
APP_ENV=development
LOG_LEVEL=INFO

# Recommendation & Vector Settings
# Model choice: 'sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2' (multilingual: en, kn, hi)
# or 'sentence-transformers/all-MiniLM-L6-v2'
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=data/faiss_index.bin
FAISS_MAPPING_PATH=data/faiss_id_mapping.json
FAISS_TOP_K=20
RECOMMENDATION_TOP_N=10

# Ranking Signal Weights (must sum to ~1.0)
SEMANTIC_WEIGHT=0.50
LOCATION_WEIGHT=0.20
DATE_WEIGHT=0.20
CATEGORY_WEIGHT=0.10

# Multilingual & Translation Settings
DEFAULT_LANGUAGE=en
TRANSLATION_PROVIDER=google
TRANSLATION_API_KEY=your_api_key_here
TRANSLATION_API_URL=https://translation.googleapis.com/language/translate/v2
TRANSLATION_CACHE_TTL_DAYS=30

# Database Settings
DATABASE_URL=sqlite:///./sanskriti_ai.db
